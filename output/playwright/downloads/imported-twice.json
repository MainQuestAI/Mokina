                "sources": [
                  "DE01",
                  "DE02",
                  "DE03"
                ]
              },
              {
                "id": "context",
                "title": "生活场景",
                "body": "明亮木色厨房、岛台与自然光形成主场景，产品清晰可辨；画面不替代安装说明。",
                "label": "创作建议",
                "sources": [
                  "DE01",
                  "DE02",
                  "DE03"
                ]
              },
              {
                "id": "position",
                "title": "产品定位",
                "body": "以 SpaceMaster 产品身份、可见设计和厨房情境构成官网入口。暂不采用容量、电压、节能、保鲜时长与嵌入式承诺。",
                "label": "创作建议",
                "sources": [
                  "DE01",
                  "DE02",
                  "DE03"
                ]
              },
              {
                "id": "priorities",
                "title": "表达优先级",
                "body": "产品外观一致、生活关系清楚、各语种含义一致。按照文字长度和阅读方向核对版式。",
                "label": "创作建议",
                "sources": [
                  "DE01",
                  "DE02",
                  "DE03"
                ]
              },
              {
                "id": "channel",
                "title": "渠道表达",
